# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev local: entra direto como admin, sem Supabase (nunca usar em produção)
DEV_AUTH_BYPASS=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Criptografia dos tokens da Meta (32 bytes em base64)
TOKEN_ENCRYPTION_KEY=

# Vercel Cron
CRON_SECRET=

# Meta / Instagram (app com instagram_business_content_publish)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# LLM (LLM_PROVIDER=anthropic|kie — kie usa a mesma KIE_API_KEY, endpoint Claude-compatível)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Busca na web (escolha um; SEARCH_PROVIDER=tavily|exa|serper)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# Geração de mídia (MEDIA_PROVIDER=kie|higgsfield)
MEDIA_PROVIDER=kie
KIE_API_KEY=
KIE_CHAT_MODEL=claude-sonnet-4-5
KIE_IMAGE_MODEL=gpt-image-2-text-to-image
KIE_VIDEO_MODEL=
KIE_AUDIO_MODEL=
KIE_WEBHOOK_HMAC_KEY=
HIGGSFIELD_API_KEY=
MEDIA_WEBHOOK_SECRET=

# Imagens livres
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
